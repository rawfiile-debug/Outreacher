# OUTREACHER: environment variables. Add the same names in Vercel > Project > Settings > Environment Variables.
# Never commit real values. Only NEXT_PUBLIC_ values are sent to the browser.

# The same Supabase project as FRAME ("invoice"), so the same sign-in works.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public address of this site, no trailing slash.
APP_URL=http://localhost:3001

# Optional: Notion. Create an internal integration at notion.so/profile/integrations, copy its secret here, then open
# the Email Contacts database in Notion > ••• > Connections and add the integration.
NOTION_TOKEN=
NOTION_CONTACTS_DATABASE_ID=2e1c086f270780cd843cfd100aa8ec14

# --- Autopilot ---------------------------------------------------------------------------------------------------
# Server access for the scheduler (Supabase > Project Settings > API Keys > secret key). SERVER ONLY.
SUPABASE_SECRET_KEY=
# Shared with the Supabase pg_cron job (supabase/scheduler.sql). Any long random string: openssl rand -hex 32
CRON_SECRET=
# Encrypts the outreach mailbox tokens. 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Google OAuth client for connecting the outreach mailbox. Authorised redirect URI: <APP_URL>/api/mailbox/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Finding businesses and writing emails
BRAVE_SEARCH_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: checks each business is a limited company (free key from developer.company-information.service.gov.uk)
COMPANIES_HOUSE_API_KEY=
